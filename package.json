{
  "name": "camila-leiva-agendamiento",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test",
    "connect:google": "node --env-file-if-exists=.env scripts/connect-google.js",
    "check:config": "node --env-file-if-exists=.env scripts/check-config.js",
    "predev": "node --env-file-if-exists=.env scripts/prepare-dev.js",
    "check:google": "node --env-file-if-exists=.env scripts/check-google.js",
    "setup:sessions": "node scripts/setup-sessions.js",
    "setup:env": "node scripts/setup-env.js",
    "setup": "node scripts/setup-env.js && node scripts/setup-sessions.js",
    "setup:google": "node scripts/setup-env.js --json-file && node scripts/setup-sessions.js"
  }
}
