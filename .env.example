# Plantilla pública sin credenciales. Ejecuta npm.cmd run setup para crear tu .env privado.
PORT=3000
GOOGLE_CLIENT_ID=
# ID, secreto y token se completan únicamente en .env, nunca en esta plantilla.
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=t.frecuenciaamorosa@gmail.com
SESSION_DURATION_MINUTES=55
SESSION_PRICE_CLP=
AVAILABLE_WEEKDAYS=3,5
AVAILABLE_HOURS=
# Opcional: JSON con horas distintas por día (0=domingo, 3=miércoles, 5=viernes).
# Si está completo, tiene prioridad sobre AVAILABLE_HOURS.
AVAILABLE_HOURS_BY_DAY='{"3":["15:00","16:00","17:00","18:00","19:00"],"5":["10:00","11:00","12:00","15:00","16:00","17:00","18:00"]}'
# Google Calendar generará un enlace Meet diferente por cada reserva.

# Cuenta que debe autorizar el asistente OAuth local.
GOOGLE_ACCOUNT_EMAIL=t.frecuenciaamorosa@gmail.com
